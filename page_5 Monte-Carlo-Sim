import streamlit as st
import numpy as np
import plotly.graph_objects as go

st.title("🎲 Monte Carlo Price Simulation (10,000 Paths)")

def monte_carlo_simulation(price, days=90, mu=0.08, sigma=0.25, simulations=10000):
    dt = 1/252
    paths = np.zeros((days, simulations))
    paths[0] = price
    for t in range(1, days):
        shock = np.random.normal(mu*dt, sigma*np.sqrt(dt), simulations)
        paths[t] = paths[t-1] * (1 + shock)
    return paths

gold_price = 3125.0  # approx current
paths_gold = monte_carlo_simulation(gold_price, sigma=0.18)

fig = go.Figure()
for i in range(0, 100, 5):  # show 20 paths for clarity
    fig.add_trace(go.Scatter(y=paths_gold[:, i], line=dict(width=1, color='rgba(255,215,0,0.3)'), showlegend=False))
fig.add_trace(go.Scatter(y=paths_gold.mean(axis=1), name="Mean Path", line=dict(color='gold', width=4)))
fig.update_layout(title="Gold Monte Carlo Simulation - 10,000 Paths (90 Days)", template="plotly_dark", height=650)
st.plotly_chart(fig, use_container_width=True)

st.success(f"90-Day Expected Gold Price: ${paths_gold.mean(axis=1)[-1]:.2f} | VaR 95%: ${np.percentile(paths_gold[-1], 5):.2f}")
